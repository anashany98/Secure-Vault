JWT_SECRET=change-me-jwt-secret
# Legacy migration-only keys. Keep them while there are users or backups created with the pre-master-password scheme.
CLIENT_VAULT_KEY=change-me-client-vault-key
CLIENT_NOTES_KEY=change-me-client-notes-key
PORT=3000
DB_CLIENT=postgres
DATABASE_URL=postgresql://securevault:change-me-postgres-password@localhost:5432/securevault
# SQLITE_DB_PATH=./secure_vault.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKUP_PATH=./backups
BACKUP_ENCRYPTION_KEY=change-me-backup-encryption-key
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
MANDATORY_2FA_ROLES=admin
MANDATORY_2FA_EMAILS=
BOOTSTRAP_ADMIN_EMAIL=admin@securevault.local
BOOTSTRAP_ADMIN_NAME=SecureVault Admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-bootstrap-password
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
